{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-push.sh" }
        ]
      }
    ]
  }
}
